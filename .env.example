APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Untuk produksi gunakan:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=user@example.com
# MAIL_PASSWORD=secret
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=user@example.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Routing / Navigasi ─────────────────────────────────────────────────
OSRM_LOCAL_ENABLED=false
OSRM_LOCAL_URL=http://127.0.0.1:5000
OSRM_LOCAL_TIMEOUT=5
# Server OSRM lokal untuk mobil/motor (car=5000). Sepeda & truk/bis memakai GraphHopper/OSRM public.
OSRM_CAR_URL=http://127.0.0.1:5000
GRAPHHOPPER_ENABLED=false
GRAPHHOPPER_URL=https://graphhopper.com/api/1
GRAPHHOPPER_TIMEOUT=30
GRAPHHOPPER_API_KEY=
GRAPHHOPPER_TRAFFIC_SPEED=
OSRM_PUBLIC_ENABLED=true
OSRM_PUBLIC_URL=https://router.project-osrm.org
OSRM_PUBLIC_TIMEOUT=15

VITE_APP_NAME="${APP_NAME}"

# ── GIS Data Sync ────────────────────────────────────────────────────────────
# External API endpoint for GIS data (GeoJSON FeatureCollection)
GIS_API_URL=https://raw.githubusercontent.com/eppofahmi/geojson-indonesia/master/kota/all_kabkota_ind.geojson
GIS_API_KEY=
GIS_API_TIMEOUT=30

# Field mapping from API to database
GIS_IDENTIFIER_FIELD=name
GIS_FIELD_NAME=name
GIS_FIELD_DESCRIPTION=description
GIS_FIELD_LATITUDE=latitude
GIS_FIELD_LONGITUDE=longitude
GIS_FIELD_CATEGORY=category
GIS_FIELD_PHOTO=photo
GIS_GEOMETRY_FIELD=geometry

# Default category for locations without category
GIS_DEFAULT_CATEGORY=Lainnya

# Pagination settings (if API supports it)
GIS_PAGINATION=false
GIS_PAGE_PARAM=page
GIS_PER_PAGE_PARAM=per_page
GIS_PER_PAGE=100

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
